  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.9",
    "pg": "^8.13.3",
