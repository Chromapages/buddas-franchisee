rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function operator() {
      return signedIn() && exists(/databases/$(database)/documents/operators/$(request.auth.uid))
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.get('status', 'ACTIVE') != 'SUSPENDED'
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.get('status', 'ACTIVE') != 'DISABLED';
    }
    function assigned(unitId) { return operator() && unitId in get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.managedUnitIds; }
    match /units/{unitId} { allow read: if assigned(unitId); allow write: if false; }
    // Credential records and sign-off acknowledgements include employee and
    // compliance information. They are server-rendered after authorization,
    // never exposed through the browser Firestore SDK.
    match /units/{unitId}/{collectionId}/{document=**} {
      // Support is server-projected: a recursive wildcard must never expose
      // privateNotes, delivery intents, command receipts or internal events.
      allow read: if assigned(unitId) && collectionId != "foodSafetyCredentials" && collectionId != "brandSignoffRequirements" && collectionId != "supportTickets";
      allow write: if false;
    }
    match /auditEvents/{eventId} { allow read, write: if false; }
    match /corporateStaff/{document=**} { allow read, write: if false; }
    match /corporateWorkRecords/{document=**} { allow read, write: if false; }
    match /corporateAuditEvents/{document=**} { allow read, write: if false; }
    match /corporateDeliveryIntents/{document=**} { allow read, write: if false; }
    match /corporateCommands/{document=**} { allow read, write: if false; }
    match /corporateAccessChanges/{document=**} { allow read, write: if false; }
    match /corporateResources/{document=**} { allow read, write: if false; }
    match /corporateResourcePublications/{document=**} { allow read, write: if false; }
    match /corporateCatalogItems/{document=**} { allow read, write: if false; }
    match /catalogPublicationBatches/{document=**} { allow read, write: if false; }
    match /corporateRegions/{document=**} { allow read, write: if false; }
    match /franchiseDevelopmentRegions/{document=**} { allow read, write: if false; }
    match /operators/{uid} { allow read: if signedIn() && uid == request.auth.uid; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
